{
  "name": "site",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "deploy-html": "minify src/index.html > ../docs/index.html",
    "deploy-css": "tailwindcss -i ./index.css -o ../docs/index.css --minify",
    "deploy": "npm run deploy-html && npm run deploy-css",
    "build": "tailwindcss -i ./index.css -o ./src/index.css",
    "watch": "tailwindcss -i ./index.css -o ./src/index.css --watch",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint --ext .html --ext .js src/",
    "format": "prettier --write ."
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "copy-webpack-plugin": "^12.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-html": "^8.1.1",
    "minify": "^11.4.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.7"
  }
}
